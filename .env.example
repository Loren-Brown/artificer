# SFTP deploy (copy to .env and fill in). Never commit .env.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# Absolute path on the server where app/dist contents are uploaded
# (should be the directory served as /artificer/ given Vite base).
SFTP_REMOTE_DIR=
# Optional: set to 1 to delete remote files under SFTP_REMOTE_DIR before upload
# SFTP_CLEAR_REMOTE=0
# Optional: set to 1 to skip `npm run app:build` and upload existing app/dist
# DEPLOY_SKIP_BUILD=0
