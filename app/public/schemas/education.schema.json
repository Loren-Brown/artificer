{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "education.schema.json",
  "title": "Education",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "name", "order"],
    "properties": {
      "order": {
        "$ref": "common.schema.json#/$defs/sortOrder"
      },
      "type": {
        "type": "string",
        "enum": [
          "university",
          "community_college",
          "high_school",
          "trade_school",
          "bootcamp",
          "certificate_program",
          "online_course",
          "military_training",
          "apprenticeship",
          "other"
        ]
      },
      "name": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "contact": {
        "$ref": "common.schema.json#/$defs/contact"
      },
      "location": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "program_name": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "degree": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "graduation_date": {
        "$ref": "common.schema.json#/$defs/calendarDate"
      },
      "start_date": {
        "$ref": "common.schema.json#/$defs/calendarDate"
      },
      "end_date": {
        "$ref": "common.schema.json#/$defs/calendarDate"
      },
      "highlights": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
