{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general.schema.json",
  "title": "General",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "contact",
    "summary"
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "contact": {
      "$ref": "common.schema.json#/$defs/contact"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/link"
      }
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "career_goals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short_term": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        },
        "long_term": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "specialties": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    },
    "disinterests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    }
  }
}
